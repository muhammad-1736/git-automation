# Git Configuration
GIT_USERNAME=your.git.username
GIT_EMAIL=your.email@example.com
MR_REVIEWER_NAME=reviewer.username

# GitLab Configuration
PERSONAL_TOKEN=your-gitlab-personal-access-token
GITLAB_API_URL=https://your.gitlab/api/v4
# Merged MRs shown in "My merge requests" for the last N days
GITLAB_MERGED_MR_DAYS=7

# Jira Configuration
JIRA_EMAIL=your.jira.email@example.com
JIRA_TOKEN=your-jira-personal-access-token
JIRA_API_URL=https://your-company.atlassian.net/rest/api/3
# Comma separated Jira display names offered as assignee after merge (also @mentioned)
JIRA_TESTERS=TESTERNAME1,TESTERNAME2

# Tempo Configuration (Tempo > Settings > API integration)
TEMPO_API_URL=https://api.tempo.io/4
TEMPO_TOKEN=your-tempo-api-token
